# FundingPlatform local-development configuration.
# Copy this file to .env and provide local values there.
# Never commit .env or real credentials.

ASPNETCORE_ENVIRONMENT="Development"
DOTNET_ENVIRONMENT=Development
AZURE_FUNCTIONS_ENVIRONMENT=Development
AZURE_TOKEN_CREDENTIALS=AzureCliCredential

# SQL Server / Azure SQL
AZURE_SQL_CONNECTION_STRING="Server=tcp:mldataset-algat3.database.windows.net,1433;Initial Catalog=res;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Default;"
AZURE_SQL_LOG_CONNECTION_STRING=

# Internal service authentication and optional provider alias
INTERNAL_API_KEY="<GENERAR_UNA_CLAVE_LOCAL_SEGURA>"
API_FOOTBALL_KEY="<API_FOOTBALL_KEY_SI_EL_PROYECTO_LA_NECESITA>"

# Authentication fallback values. Development normally loads secrets from Key Vault.
JWT_SECRET=
JWT_ISSUER="https://localhost:5070"
JWT_AUDIENCE="FundingPlatform.Web"
AUTH_ACCESS_TOKEN_MINUTES="15"
AUTH_REFRESH_TOKEN_DAYS="30"
AUTH_ADMIN_SESSION_MINUTES="60"
SECURITY_IP_HASH_PEPPER=
SECURITY_RECOVERY_CODE_PEPPER=

# Microsoft Entra SSO público: cuentas organizacionales y Microsoft personales
ENTRA_SSO_ENABLED="false"
ENTRA_SSO_TENANT_ID="common"
ENTRA_SSO_CLIENT_ID=
ENTRA_SSO_CLIENT_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Storage, Key Vault and Azure Functions
AZURE_STORAGE_CONNECTION_STRING=
# Azure Functions host storage must be configured in local.settings.json locally or
# as Azure App Settings in production. FundingPlatform.Workers also uses this family
# for the 7A `imports` queue; FundingPlatform.ExtractionWorkers does not use it for
# extraction data and must have its own host-storage account in Azure.
AzureWebJobsStorage=
AzureWebJobsStorage__accountName=
# Explicit endpoint alternative to accountName; configure both when using it.
AzureWebJobsStorage__queueServiceUri=
AzureWebJobsStorage__blobServiceUri=
# Hosted Azure environments require managedidentity. This same key is configured
# per Function App with a different UAMI: H_general in FundingPlatform.Workers and
# the host-only H_extractor in FundingPlatform.ExtractionWorkers. H_general,
# H_extractor and both queue identities below must all be distinct, and each app
# must attach only its own identities. Leave credential/clientId empty only for
# local Azurite/developer identity.
AzureWebJobsStorage__credential=
AzureWebJobsStorage__clientId=
# Dedicated `document-extractions` data queue shared by the general publisher and
# the isolated extraction consumer. In Azure, only ExtractionWorkers requires its
# AzureWebJobsStorage to be host-only and distinct from this queue and document Blob.
DocumentExtractionQueueStorage=
DocumentExtractionQueueStorage__accountName=
DocumentExtractionQueueStorage__queueServiceUri=
DocumentExtractionQueueStorage__credential=
# Processor identity: Queue Processor + trusted Blob reader + extraction SQL role.
DocumentExtractionQueueStorage__clientId=
# Publisher identity: Queue Data Message Sender only. Must differ from clientId.
DocumentExtractionQueueStorage__senderClientId=
IMPORT_WORKER_LEASE_SECONDS="1800"
IMPORT_SCHEDULER_BATCH_SIZE="10"
IMPORT_OUTBOX_BATCH_SIZE="25"
GRANTS_GOV_TIMEOUT_SECONDS="20"
IMPORT_ALLOWED_PROVIDERS="grants-gov"
CONTENT_RETENTION_BATCH_SIZE="100"
CONTENT_RETENTION_SOURCE_DOCUMENT_BATCH_SIZE="25"
CONTENT_RETENTION_SOURCE_DOCUMENT_LEASE_SECONDS="900"
AZURE_KEY_VAULT_URI="https://fpong-kv-dev.vault.azure.net/"
AZURE_STORAGE_DATA_PROTECTION_BLOB_URI="https://fpongdev1234.blob.core.windows.net/dataprotection/keys.xml"
AZURE_KEY_VAULT_DATA_PROTECTION_KEY_URI="https://fpong-kv-dev.vault.azure.net/keys/data-protection"

# Secure administrative source-document upload (private Blob containers)
AZURE_STORAGE_BLOB_SERVICE_URI="https://fpongdev1234.blob.core.windows.net"
SOURCE_DOCUMENT_INCOMING_CONTAINER="fp-source-incoming"
SOURCE_DOCUMENT_QUARANTINE_CONTAINER="fp-source-quarantine"
SOURCE_DOCUMENT_TRUSTED_CONTAINER="fp-source-trusted"
SOURCE_DOCUMENT_MAX_BYTES="26214400"
SOURCE_DOCUMENT_UPLOAD_TTL_MINUTES="5"
SOURCE_DOCUMENT_FINALIZE_LEASE_SECONDS="120"
SOURCE_DOCUMENT_SCAN_TIMEOUT_SECONDS="10"
SOURCE_DOCUMENT_SCAN_MODE="DevelopmentFake"
SOURCE_DOCUMENT_DEVELOPMENT_FAKE_RESULT="Clean"

# Durable, bounded PDF text extraction. Only Clean + Trusted documents are eligible.
DOCUMENT_EXTRACTION_MAX_BYTES="10485760"
DOCUMENT_EXTRACTION_MAX_PAGES="250"
DOCUMENT_EXTRACTION_MAX_CHARACTERS="500000"
DOCUMENT_EXTRACTION_MAX_UTF8_BYTES="2097152"
DOCUMENT_EXTRACTION_MAX_STACK_DEPTH="64"
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS="120"
DOCUMENT_EXTRACTION_LEASE_SECONDS="300"
DOCUMENT_EXTRACTION_WATCHDOG_BATCH_SIZE="25"

# Defender Event Grid ingress stays disabled locally. Production requires every
# exact, non-secret resource identifier plus an operator-configured SQL trust policy.
DEFENDER_EVENT_GRID_ENABLED="false"
DEFENDER_EVENT_GRID_TENANT_ID=
DEFENDER_EVENT_GRID_AUDIENCE=
DEFENDER_EVENT_GRID_CALLER_APPLICATION_ID=
DEFENDER_EVENT_GRID_CALLER_OBJECT_ID=
DEFENDER_EVENT_GRID_TOPIC_RESOURCE_ID=
DEFENDER_EVENT_GRID_SUBSCRIPTION_NAME=
DEFENDER_EVENT_GRID_STORAGE_RESOURCE_ID=
DEFENDER_PENDING_SCAN_TIMEOUT_MINUTES="240"
DEFENDER_WATCHDOG_BATCH_SIZE="25"

# One fixed official RSS endpoint may be enabled only after license/compliance review.
OFFICIAL_RSS_ENABLED="false"
OFFICIAL_RSS_FEED_URI=
OFFICIAL_RSS_ALLOWED_HOSTS=
OFFICIAL_RSS_SOURCE_NAME=
OFFICIAL_RSS_SPONSOR_NAME=
OFFICIAL_RSS_LICENSE_NAME=
OFFICIAL_RSS_LICENSE_URI=
OFFICIAL_RSS_COMPLIANCE_APPROVED="false"
OFFICIAL_RSS_ROBOTS_POLICY="Enforce"
OFFICIAL_RSS_ROBOTS_POLICY_VERSION="1"
OFFICIAL_RSS_MINIMUM_DELAY_SECONDS="2"
OFFICIAL_RSS_TIMEOUT_SECONDS="15"
OFFICIAL_RSS_MAXIMUM_BYTES="1048576"
OFFICIAL_RSS_MAXIMUM_CHARACTERS="1000000"
OFFICIAL_RSS_MAXIMUM_ITEMS="25"
OFFICIAL_RSS_USER_AGENT="FundingPlatform-Workers/1.0"

# Email
AZURE_COMMUNICATION_SERVICES_ENDPOINT="https://fpong-comms-dev-1234.unitedstates.communication.azure.com"
EMAIL_FROM_ADDRESS="DoNotReply@4f9778b0-fc85-4220-a8f4-d1c07e122733.azurecomm.net"

# Billing
PAYMENT_PROVIDER=MercadoPago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Browser application and CORS
BACKEND_API_BASE_URL="http://localhost:5070"
FRONTEND_BASE_URL="http://localhost:5173"
ALLOWED_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
VITE_API_BASE_URL="/api/v1"
VITE_EXTERNAL_AUTH_BASE_URL="http://localhost:5070/api/v1"

# Production-oriented integration points. Leave empty locally unless needed.
KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=
